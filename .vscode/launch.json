{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Glassbox server (debug)",
            "type": "node-terminal",
            "request": "launch",
            "command": "uv run glassbox --reload",
            "cwd": "${workspaceFolder}",
            "env": {
                "GLASSBOX_LOGGING_LEVEL": "DEBUG",
                "UVICORN_LOG_LEVEL": "debug"
            }
        }
    ]
}
